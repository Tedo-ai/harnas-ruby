{
  "harnas_version": "0.1",
  "name": "builtin-tools",

  "system": "You help users read, write, and inspect files on the local filesystem. Be terse.",

  "provider": {
    "kind": "mock",
    "model": "mock-test",
    "max_tokens": 1024
  },

  "tools": [
    {
      "name": "read_file",
      "handler": "harnas.builtin.read_file",
      "description": "Read the contents of a file at the given path.",
      "input_schema": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"]
      }
    },
    {
      "name": "list_dir",
      "handler": "harnas.builtin.list_dir",
      "description": "List entries in a directory.",
      "input_schema": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"]
      }
    }
  ],

  "strategies": []
}
