{
  "harnas_version": "0.1",
  "name": "research_agent",

  "provider": {
    "kind": "anthropic",
    "model": "claude-opus-4-7",
    "max_tokens": 4096
  },

  "tools": [
    {
      "name": "web_search",
      "handler": "acme.tools.websearch.search",
      "description": "Search the web for a query. Returns titles and URLs.",
      "input_schema": {
        "type": "object",
        "properties": { "q": { "type": "string" } },
        "required": ["q"]
      }
    },
    {
      "name": "web_fetch",
      "handler": "acme.tools.websearch.fetch",
      "description": "Fetch the text content of a URL.",
      "input_schema": {
        "type": "object",
        "properties": { "url": { "type": "string" } },
        "required": ["url"]
      }
    },
    {
      "name": "write_file",
      "handler": "acme.tools.fs.write",
      "description": "Write text to a file in the working directory.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "content": { "type": "string" }
        },
        "required": ["path", "content"]
      }
    }
  ],

  "strategies": [
    {
      "name": "Compaction::MarkerTail",
      "config": { "max_messages": 20, "keep_recent": 10 }
    },
    {
      "name": "Permission::DenyByName",
      "config": { "names": ["shell", "exec"] }
    },
    {
      "name": "Permission::HumanApproval",
      "config": { "prompt": "acme.approvals.cli_prompt" }
    }
  ]
}
